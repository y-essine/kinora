#!/usr/bin/python3
"""Prepare a video for instant playback, ahead of time.

    kinora-prepare [--audio] URL OUT_PATH_WITHOUT_EXTENSION

Runs the same extraction as Clapper's yt-dlp enhancer (same options, its
YouTube extractor override and its manifest generators), writes the resulting
HLS or DASH manifest next to OUT_PATH and prints the written path. Kinora runs
this in the background for the video you're most likely to watch next (the
first "Up next"); playing the prepared file then skips the several seconds of
extraction. The stream links in it stay valid for hours.

With --audio the manifest holds only the audio, in the original language (the
DJ plays music that way): it starts in about half the time and costs no video
decoding.
"""
import copy
import os
import sys
import urllib.request
from concurrent.futures import ThreadPoolExecutor

# Clapper's yt-dlp enhancer: the system's on Linux; the Windows build ships it
# next to this script's folder (lib/clapper-0.0/enhancers/yt-dlp).
ENHANCER = os.environ.get("KINORA_CLAPPER_ENHANCER") or next(
    (p for p in (
        "/usr/lib/clapper-0.0/enhancers/yt-dlp",
        os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib",
                     "clapper-0.0", "enhancers", "yt-dlp"),
    ) if os.path.isdir(p)),
    "/usr/lib/clapper-0.0/enhancers/yt-dlp")
sys.path.insert(0, ENHANCER)

import clapper_yt_dlp as clapper  # noqa: E402  (options, as Clapper uses them)
import clapper_yt_dlp_dash as dash  # noqa: E402
import clapper_yt_dlp_hls as hls  # noqa: E402
from clapper_yt_dlp_overrides import BLACKLIST, ClapperYoutubeIE  # noqa: E402
from yt_dlp import YoutubeDL  # noqa: E402
from yt_dlp.extractor import gen_extractor_classes  # noqa: E402

# Clapper's default "codecs-order" setting.
CODECS_ORDER = "avc1,av01,hev1,vp09"

# YouTube sometimes serves HLS playlists that answer 404 for a whole codec
# family (seen: every H.264 rendition of a video with dubbed audio, while VP9
# worked). Such a manifest plays nothing, so check its playlists and pick again
# without the dead ones.
MAX_ROUNDS = 4


def alive(url):
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=5) as r:
            r.read(16)
            return True
    except Exception:
        return False


def audio_manifest(info):
    """A master playlist with the one chosen audio rendition."""
    url = info.get("url")
    if not url or info.get("protocol") != "m3u8_native":
        return None
    bandwidth = int((info.get("tbr") or info.get("abr") or 128) * 1000)
    codec = info.get("acodec") or "mp4a.40.2"
    if (vcodec := info.get("vcodec") or "none") != "none":
        codec = f"{vcodec},{codec}"
    return (f'#EXTM3U\n#EXT-X-INDEPENDENT-SEGMENTS\n'
            f'#EXT-X-STREAM-INF:BANDWIDTH={bandwidth},CODECS="{codec}"\n{url}\n')


def checked_uris(manifest):
    """Playlists the player will load: every variant and the default audio."""
    lines = manifest.splitlines()
    uris = []
    for i, line in enumerate(lines):
        if line.startswith("#EXT-X-STREAM-INF") and i + 1 < len(lines):
            uris.append(lines[i + 1].strip())
        elif line.startswith("#EXT-X-MEDIA") and "DEFAULT=YES" in line and 'URI="' in line:
            uris.append(line.split('URI="', 1)[1].split('"', 1)[0])
    return [u for u in uris if u.startswith("http")]


def main():
    args = sys.argv[1:]
    audio = "--audio" in args
    args = [a for a in args if a != "--audio"]
    if len(args) != 2:
        sys.exit(__doc__)
    url, out = args

    opts = dict(clapper.YTDL_OPTS)
    opts.update(quiet=True, verbose=False, noprogress=True)
    opts["format_sort"] = ["vcodec:" + c for c in CODECS_ORDER.split(",")] + [
        "acodec:mp4a", "acodec:opus", "acodec:vorbis", "acodec:*"]

    if audio:
        # The best HLS audio; yt-dlp ranks the original language first.
        # Signed in, YouTube may offer no HLS audio alone: then the smallest
        # HLS video with proper AAC (the DJ decodes no video anyway).
        opts["format"] = ("bestaudio[protocol=m3u8_native]"
                          "/best[protocol=m3u8_native][height<=360][acodec^=mp4a.40.2]"
                          "/best[protocol=m3u8_native]")

    # Signed in (KINORA_COOKIES: the account's cookies.txt), YouTube doesn't ask
    # to "confirm you're not a bot" as it does anonymous clients after heavy use.
    cookies = os.environ.get("KINORA_COOKIES")
    if cookies and os.path.exists(cookies):
        # A private copy: yt-dlp may write cookies back, and two runs at once
        # must not share the file.
        import shutil
        import tempfile
        fd, copy_path = tempfile.mkstemp(suffix=".txt")
        os.close(fd)
        shutil.copyfile(cookies, copy_path)
        opts["cookiefile"] = copy_path
        import atexit
        atexit.register(lambda: os.path.exists(copy_path) and os.remove(copy_path))

    # YouTube's web clients (the ones used when signed in) need a JavaScript
    # challenge solved; yt-dlp does it with any of these it finds.
    import shutil
    runtimes = {r: {} for r in ("deno", "node", "bun") if shutil.which(r)}
    if runtimes:
        opts["js_runtimes"] = runtimes

    ytdl = YoutubeDL(opts, auto_init=False)
    ytdl.add_info_extractor(ClapperYoutubeIE())
    for ie in gen_extractor_classes():
        if ie._ENABLED and ie.ie_key() not in BLACKLIST:
            ytdl.add_info_extractor(ie)
    raw = ytdl.extract_info(url, download=False, process=False)
    if opts.get("cookiefile"):
        # Signed-in web clients' separate (DASH) streams answer 403 without a
        # PO token; their HLS streams play.
        raw["formats"] = [f for f in raw.get("formats") or []
                          if f.get("protocol") == "m3u8_native"]

    for _ in range(MAX_ROUNDS):
        info = ytdl.process_ie_result(copy.deepcopy(raw), download=False)
        if audio:
            manifest = audio_manifest(info)
            if manifest:
                path = out + ".audio.m3u8"
            elif manifest := dash.generate_manifest(info):
                path = out + ".audio.mpd"
                break  # DASH links are media files, not playlists: not checked
            else:
                sys.exit("kinora-prepare: no HLS or DASH audio")
        elif manifest := hls.generate_manifest(info):
            path = out + ".m3u8"
        elif manifest := dash.generate_manifest(info):
            path = out + ".mpd"
            break  # DASH links are media files, not playlists: not checked
        else:
            sys.exit("kinora-prepare: no playable manifest")
        uris = checked_uris(manifest)
        with ThreadPoolExecutor(max_workers=8) as pool:
            dead = {u for u, ok in zip(uris, pool.map(alive, uris)) if not ok}
        if not dead:
            break
        print(f"kinora-prepare: {len(dead)} of {len(uris)} playlists dead, picking again",
              file=sys.stderr)
        before = len(raw.get("formats") or [])
        formats = raw.get("formats") or []
        # A dead video rendition takes its codec family with it (they fail
        # together, and the generator would otherwise fall to tiny ones).
        families = {(f.get("vcodec") or "")[:4] for f in formats
                    if f.get("url") in dead and (f.get("vcodec") or "none") != "none"}
        raw["formats"] = [
            f for f in formats
            if f.get("url") not in dead
            and not (f.get("protocol") == "m3u8_native"
                     and (f.get("vcodec") or "none")[:4] in families)]
        if len(raw["formats"]) == before:
            sys.exit("kinora-prepare: dead playlists, no formats left to drop")
    else:
        sys.exit("kinora-prepare: no working playlists")

    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    tmp = path + ".part"
    with open(tmp, "w") as f:
        f.write(manifest)
    os.replace(tmp, path)
    print(path)


if __name__ == "__main__":
    main()
