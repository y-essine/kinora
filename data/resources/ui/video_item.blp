using Gtk 4.0;
using Adw 1;
using Gdk 4.0;

// Kinora: the video card (see docs/design.md). "wide" is the poster card used
// in grids and rows, "compact" the list card used in narrow windows and Up next.
template $TFVideoItem: Box {
  styles [
    "k-card",
  ]

  tooltip-text: bind template.video as <$TFVideo>.title;

  EventControllerMotion {
    enter => $handle_hover_enter() swapped;
    leave => $handle_hover_leave() swapped;
  }

  GestureClick {
    button: 3;
    exclusive: true;
    pressed => $handle_right_clicked() swapped;
  }

  GestureLongPress {
    touch-only: true;
    exclusive: true;
    pressed => $handle_long_pressed() swapped;
  }

  Adw.MultiLayoutView multi_layout_view {
    Adw.Layout {
      name: "wide";

      content: Adw.Clamp clamp_wide {
        maximum-size: 288;

        child: Gtk.Box {
          orientation: vertical;
          spacing: 10;

          Adw.LayoutSlot slot_image_wide {
            id: "image";
            width-request: 288;
            height-request: 162;
          }

          Box {
            spacing: 10;

            Adw.LayoutSlot {
              id: "avatar";
              valign: start;
            }

            Box {
              orientation: vertical;
              spacing: 2;
              hexpand: true;

              Adw.LayoutSlot {
                id: "title";
              }

              Box {
                spacing: 5;

                Adw.LayoutSlot {
                  id: "author";
                }

                Adw.LayoutSlot {
                  id: "date";
                }
              }
            }
          }
        };
      };
    }

    Adw.Layout {
      name: "compact";

      content: Gtk.Box {
        orientation: horizontal;
        spacing: 12;

        Adw.LayoutSlot {
          id: "image";
          width-request: 160;
          height-request: 90;
          valign: start;
        }

        Gtk.Box {
          orientation: vertical;
          spacing: 4;
          valign: center;
          hexpand: true;

          Adw.LayoutSlot {
            id: "title";
          }

          Box {
            spacing: 6;

            Adw.LayoutSlot {
              id: "avatar";
            }

            Adw.LayoutSlot {
              id: "author";
            }
          }

          Adw.LayoutSlot {
            id: "date";
            halign: start;
          }
        }
      };
    }

    [image]
    Overlay overlay {
      styles [
        "k-thumb-frame",
      ]

      overflow: hidden;

      [overlay]
      Box {
        styles [
          "k-badge",
          "numeric",
        ]

        valign: end;
        halign: start;
        margin-bottom: 6;
        margin-start: 6;
        spacing: 3;
        visible: bind $or(template.video as <$TFVideo>.downloading, template.video as <$TFVideo>.downloaded) as <bool>;

        Image {
          icon-name: "folder-download-symbolic";
          pixel-size: 12;
        }

        Adw.Spinner {
          accessibility {
            description: _("Video is downloading");
          }

          visible: bind template.video as <$TFVideo>.downloading;
        }
      }

      [overlay]
      Box {
        styles [
          "k-badge",
          "numeric",
        ]

        valign: end;
        halign: end;
        margin-bottom: 6;
        margin-end: 6;
        spacing: 4;

        Label {
          label: bind template.video as <$TFVideo>.duration-label;
        }

        Image {
          icon-name: bind $icon_name_for_platform(template.video as <$TFVideo>.platform) as <string>;
          pixel-size: 12;
        }
      }

      // Shown with the pointer over the card (faded in by CSS).
      [overlay]
      Box {
        styles [
          "k-card-actions",
        ]

        margin-top: 6;
        margin-start: 6;
        margin-end: 6;
        visible: bind template.compact inverted;
        valign: start;

        Button {
          styles [
            "circular",
            "osd",
          ]

          tooltip-text: bind $watch_later_tooltip_text(template.video as <$TFVideo>.watch-later) as <string>;
          icon-name: bind $watch_later_icon_name(template.video as <$TFVideo>.watch-later) as <string>;
          action-name: "video-item.watch-later";
        }

        Gtk.Button btn_more_actions {
          halign: end;
          hexpand: true;

          styles [
            "circular",
            "osd",
          ]

          tooltip-text: _("More Actions");
          icon-name: "view-more-horizontal-symbolic";
          clicked => $handle_more_actions_clicked() swapped;
        }
      }

      Picture thumbnail {
        styles [
          "k-thumb",
        ]

        content-fit: cover;
        can-shrink: true;
        paintable: bind $pixbuf_to_paintable(template.video as <$TFVideo>.thumbnail) as <Gdk.Paintable>;
      }
    }

    [avatar]
    Adw.Avatar avatar {
      styles [
        "k-avatar",
      ]

      custom-image: bind $pixbuf_to_paintable(
        template.video as <$TFVideo>.uploader as <$TFChannel>.avatar
        ) as <Gdk.Paintable>;
      text: bind template.video as <$TFVideo>.uploader as <$TFChannel>.name;
      size: 32;
    }

    [author]
    Label {
      styles [
        "k-card-meta",
      ]

      label: bind template.video as <$TFVideo>.uploader as <$TFChannel>.name;
      ellipsize: end;
      lines: 1;
      halign: start;
      xalign: 0;
    }

    [date]
    Label {
      styles [
        "k-card-meta",
      ]

      label: bind $meta_date(template.video as <$TFVideo>.uploaded-label, template.compact) as <string>;
      ellipsize: end;
      lines: 1;
      xalign: 0;
    }

    [title]
    Label label_title {
      styles [
        "k-card-title",
      ]

      label: bind template.video as <$TFVideo>.title;
      wrap: true;
      wrap-mode: word_char;
      ellipsize: end;
      lines: 2;
      xalign: 0;
    }
  }

  PopoverMenu popover_menu {}
}
