using Gtk 4.0;
using Adw 1;
using ClapperGtk 0.0;
using Gdk 4.0;

template $TFVideoPage: Adw.Bin {
  ShortcutController {
    scope: local;
    propagation-phase: bubble;

    Shortcut {
      trigger: "greater";
      action: "action(video.speed-up)";
    }

    Shortcut {
      trigger: "less";
      action: "action(video.speed-down)";
    }

    Shortcut {
      trigger: "Up";
      action: "action(video.volume-up)";
    }

    Shortcut {
      trigger: "Down";
      action: "action(video.volume-down)";
    }

    Shortcut {
      trigger: "m";
      action: "action(video.toggle-mute)";
    }

    // Kinora: the sheet and the queue (see docs/design.md, "Player").
    Shortcut {
      trigger: "i";
      action: "action(win.minimize-player)";
    }

    Shortcut {
      trigger: "<Shift>n";
      action: "action(win.player-next)";
    }

    Shortcut {
      trigger: "<Shift>p";
      action: "action(win.player-previous)";
    }

    Shortcut {
      trigger: "space";
      action: "action(video.play-pause)";
    }

    Shortcut {
      trigger: "Right";
      action: "action(video.seek-forward)";
    }

    Shortcut {
      trigger: "Left";
      action: "action(video.seek-backward)";
    }

    // TODO: Maybe do that programmatically, instead of listing everything.
    Shortcut {
      trigger: "0";
      action: "action(video.seek-percentile)";
      arguments: "0";
    }

    Shortcut {
      trigger: "1";
      action: "action(video.seek-percentile)";
      arguments: "1";
    }

    Shortcut {
      trigger: "2";
      action: "action(video.seek-percentile)";
      arguments: "2";
    }

    Shortcut {
      trigger: "3";
      action: "action(video.seek-percentile)";
      arguments: "3";
    }

    Shortcut {
      trigger: "4";
      action: "action(video.seek-percentile)";
      arguments: "4";
    }

    Shortcut {
      trigger: "5";
      action: "action(video.seek-percentile)";
      arguments: "5";
    }

    Shortcut {
      trigger: "6";
      action: "action(video.seek-percentile)";
      arguments: "6";
    }

    Shortcut {
      trigger: "7";
      action: "action(video.seek-percentile)";
      arguments: "7";
    }

    Shortcut {
      trigger: "8";
      action: "action(video.seek-percentile)";
      arguments: "8";
    }

    Shortcut {
      trigger: "9";
      action: "action(video.seek-percentile)";
      arguments: "9";
    }
  }

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar header_bar {
      visible: bind template.fullscreened inverted;

      // Kinora: shrink the page into the mini-player.
      [start]
      Gtk.Button {
        icon-name: "go-down-symbolic";
        tooltip-text: _("Minimize Player (Esc)");
        action-name: "win.minimize-player";
      }

      [start]
      Gtk.ToggleButton main_toggle_sidebar {
        visible: bind template.show-sidebar-visible;
        tooltip-text: _("Show Sidebar");
        action-name: "win.toggle-sidebar";
        icon-name: "sidebar-show-symbolic";
      }

      [end]
      MenuButton primary_menu_button {
        accessibility {
          label: C_("accessibility", "Primary menu");
        }

        primary: true;
        menu-model: menubar;
        tooltip-text: C_("tooltip", "Primary menu");
        icon-name: 'open-menu-symbolic';
      }

      title-widget: Adw.WindowTitle main_title {};
    }

    // Kinora: one scrolling column, so the player scrolls away with the
    // page like on YouTube. In fullscreen only the player is left, filling it.
    ScrolledWindow page_scroller {
    hscrollbar-policy: never;
    vexpand: true;

    Gtk.Box {
      orientation: vertical;
      valign: fill;
      vexpand: true;
      // Kinora: the stage. Behind the player, the video's own colours as a
      // soft light (its thumbnail, blurred once: see Utility::ambient_texture).
      Overlay stage {
        styles [
          "k-stage",
        ]

        Picture stage_glow {
          styles [
            "k-glow",
            "k-stage-glow",
          ]

          content-fit: fill;
          can-shrink: true;
          accessible-role: presentation;
          visible: bind template.fullscreened inverted;
          paintable: bind $pixbuf_to_ambient(template.video as <$TFVideo>.thumbnail) as <Gdk.Paintable>;
        }

        [overlay]
        Box stage_scrim {
          styles [
            "k-stage-scrim",
          ]

          can-target: false;
          visible: bind template.fullscreened inverted;
        }

        // Sized in `setup`: 16:9, as large as the window allows.
        [overlay]
        Adw.Clamp stage_clamp {
          Box player_frame {
            styles [
              "k-player",
            ]

            orientation: vertical;
            overflow: hidden;

                // The player for playing internally.
                ClapperGtk.Video clapper {
                  focusable: true;
                  auto-inhibit: true;
                  visible: bind template.external inverted;
                  valign: fill;
                  vexpand: bind template.fullscreened;

                  // Kinora: audio only (the DJ): the artwork on its own colours
                  // takes the video's place.
                  [overlay]
                  Overlay {
                    styles [
                      "k-artwork-stage",
                    ]

                    visible: bind template.audio-only;
                    can-target: false;

                    Picture {
                      styles [
                        "k-glow",
                      ]

                      content-fit: fill;
                      can-shrink: true;
                      accessible-role: presentation;
                      paintable: bind $pixbuf_to_ambient(template.video as <$TFVideo>.thumbnail) as <Gdk.Paintable>;
                    }

                    // (The frame takes the picture's own shape, square or wide.)
                    [overlay]
                    AspectFrame {
                      styles [
                        "k-artwork-frame",
                      ]

                      obey-child: true;

                      Picture {
                        styles [
                          "k-artwork",
                        ]

                        overflow: hidden;
                        content-fit: cover;
                        can-shrink: true;
                        accessible-role: presentation;
                        paintable: bind $pixbuf_to_paintable(template.video as <$TFVideo>.thumbnail) as <Gdk.Paintable>;
                      }
                    }
                  }

                  // Kinora: while the video starts, its thumbnail and a spinner instead
                  // of a black player.
                  [overlay]
                  Overlay {
                    visible: bind template.loading;
                    can-target: false;

                    [overlay]
                    Adw.Spinner {
                      width-request: 48;
                      height-request: 48;
                      halign: center;
                      valign: center;
                    }

                    Picture {
                      // (Audio only: the artwork is there already.)
                      visible: bind template.audio-only inverted;
                      content-fit: contain;
                      opacity: 0.6;
                      paintable: bind $pixbuf_to_paintable(template.video as <$TFVideo>.thumbnail) as <Gdk.Paintable>;
                    }
                  }

                  [fading-overlay]
                  ClapperGtk.TitleHeader {
                    valign: start;
                    visible: bind template.fullscreened;
                  }

                  [fading-overlay]
                  ClapperGtk.SimpleControls {
                    valign: end;
                    // Kinora: the mini-player has its own controls.
                    visible: bind template.minimized inverted;
                  }

                  // Kinora: fill the window (not the screen) with the video.
                  [fading-overlay]
                  Gtk.Button {
                    halign: end;
                    valign: start;
                    margin-top: 8;
                    margin-end: 8;
                    visible: bind template.minimized inverted;
                    icon-name: bind $window_fullscreen_icon(template.fullscreened, template.window-mode) as <string>;
                    tooltip-text: bind $window_fullscreen_tooltip(template.fullscreened, template.window-mode) as <string>;
                    clicked => $toggle_window_fullscreen() swapped;

                    styles [
                      "osd",
                      "circular",
                    ]
                  }

                  [overlay]
                  ClapperGtk.Billboard billboard {
                    visible: bind template.minimized inverted;
                  }

                  toggle-fullscreen => $toggle_fullscreen() swapped;
                }

                // The image for playing externally
                Overlay {
                  visible: bind template.external;
                  valign: start;
                  vexpand: false;

                  [overlay]
                  Label {
                    styles [
                      "osd",
                      "title-1",
                    ]

                    label: _("Video is Playing Externally");
                    valign: fill;
                    halign: fill;
                  }

                  [overlay]
                  Button {
                    valign: fill;
                    halign: fill;
                    clicked => $play_external() swapped;
                  }

                  Picture thumbnail {
                    halign: fill;
                    valign: start;
                    hexpand: true;
                    vexpand: true;
                    paintable: bind $pixbuf_to_paintable(template.video as <$TFVideo>.thumbnail) as <Gdk.Paintable>;
                  }
                }
          }
        }
      }

      Gtk.Box details_box {
        orientation: vertical;
        visible: bind template.fullscreened inverted;

        Adw.Clamp body_clamp {
          styles [
            "k-video-body",
          ]

          maximum-size: 850;

          Box body {
            orientation: vertical;
            spacing: 24;

          Box {
            orientation: vertical;
            spacing: 12;
            hexpand: true;
            valign: start;

            Label label_title {
              styles [
                "k-display",
                "k-video-title",
              ]

              label: bind template.video as <$TFVideo>.title;
              selectable: true;
              ellipsize: end;
              wrap: true;
              wrap-mode: word;
              lines: 2;
              justify: left;
              valign: start;
              xalign: 0;
            }

            Adw.WrapBox box {
              orientation: horizontal;
              child-spacing: 6;
              line-spacing: 6;

              Gtk.Button {
                styles [
                  "circular",
                ]

                halign: start;
                hexpand: true;
                clicked => $display_channel() swapped;

                Box {
                  margin-top: 6;
                  margin-bottom: 6;
                  margin-start: 6;
                  margin-end: 12;
                  spacing: 12;

                  Adw.Avatar {
                    custom-image: bind $pixbuf_to_paintable(
                      template.video as <$TFVideo>.uploader as <$TFChannel>.avatar
                      ) as <Gdk.Paintable>;
                    text: bind template.video as <$TFVideo>.uploader as <$TFChannel>.name;
                    size: 32;
                  }

                  Box {
                    orientation: vertical;

                    Label label_author {
                      label: bind template.video as <$TFVideo>.uploader as <$TFChannel>.name;
                      single-line-mode: true;
                      ellipsize: end;
                      max-width-chars: 30;
                      justify: left;
                      valign: center;
                      halign: start;
                    }

                    Box {
                      orientation: horizontal;
                      spacing: 6;

                      Gtk.Image {
                        styles [
                          "dimmed",
                        ]

                        icon-name: bind $icon_name_for_platform(template.video as <$TFVideo>.platform) as <string>;
                        height-request: 12;
                        width-request: 12;
                        valign: center;
                      }

                      Label label_subscribers {
                        styles [
                          "caption",
                          "dim-label",
                        ]

                        label: bind $format_subscribers(
                          template.video as <$TFVideo>.uploader as <$TFChannel>.subscribers
                          ) as <string>;
                        visible: bind template.video as <$TFVideo>.uploader as <$TFChannel>.has-subscribers;
                        single-line-mode: true;
                        justify: left;
                        valign: start;
                        halign: start;
                        ellipsize: end;
                      }
                    }
                  }
                }
              }

              Box button_box {
                valign: center;
                hexpand: false;
                halign: end;
                spacing: 6;

                // Kinora: endless music from this video (see gui/dj.rs).
                Gtk.Button {
                  styles [
                    "pill",
                    "k-dj-start",
                  ]

                  action-name: "win.dj-start";
                  tooltip-text: _("Play music like this, endlessly");
                  visible: bind $dj_offered(template.dj-available, template.dj, template.video as <$TFVideo>.platform) as <bool>;

                  Gtk.Box {
                    spacing: 6;

                    Gtk.Image {
                      icon-name: "audio-headphones-symbolic";
                    }

                    Gtk.Label {
                      label: _("Start DJ");
                    }
                  }
                }

                Gtk.Button {
                  styles [
                    "pill",
                  ]

                  tooltip-text: _("Download");
                  clicked => $download() swapped;

                  Gtk.Box {
                    spacing: 3;

                    Gtk.Image {
                      icon-name: "folder-download-symbolic";
                    }

                    Gtk.Label {
                      accessibility {
                        description: "Download progress";
                      }

                      styles [
                        "numeric",
                      ]

                      label: bind $format_percent(template.video as <$TFVideo>.download-progress) as <string>;
                      visible: bind template.video as <$TFVideo>.downloading;
                    }
                  }

                  visible: bind $not(template.video as <$TFVideo>.downloaded) as <bool>;
                  sensitive: bind $not(template.video as <$TFVideo>.downloading) as <bool>;
                }

                Gtk.Button {
                  styles [
                    "pill",
                  ]

                  icon-name: "edit-delete-symbolic";
                  tooltip-text: _("Remove Local Copy");
                  clicked => $remove_downloaded() swapped;
                  visible: bind template.video as <$TFVideo>.downloaded;
                }

                Gtk.Button {
                  styles [
                    "pill",
                  ]

                  action-name: "win.watch-later";
                  tooltip-text: bind $watch_later_tooltip_text(template.video as <$TFVideo>.watch-later) as <string>;
                  icon-name: bind $watch_later_icon_name(template.video as <$TFVideo>.watch-later) as <string>;
                }

                Gtk.Button {
                  styles [
                    "pill",
                  ]

                  icon-name: "edit-copy-symbolic";
                  tooltip-text: _("Copy Video Link");
                  clicked => $copy_to_clipboard() swapped;
                }
              }
            }

            Gtk.Box {
              orientation: vertical;
              spacing: 5;

              styles [
                "k-panel",
                "video-description",
              ]

              Gtk.Box {
                Adw.WrapBox {
                  line-spacing: 6;
                  child-spacing: 6;

                  Label label_uploaded {
                    label: bind $format_uploaded(template.video as <$TFVideo>.uploaded-label) as <string>;
                    selectable: true;
                    single-line-mode: true;
                    justify: left;
                    halign: start;
                    ellipsize: start;
                    hexpand: true;

                    styles [
                      "heading",
                    ]
                  }

                  Box box_numbers {
                    spacing: 12;
                    halign: start;
                    hexpand: false;

                    Box box_views {
                      styles [
                        "dim-label",
                      ]

                      visible: bind template.video as <$TFVideo>.has-views;
                      spacing: 6;

                      Image {
                        icon-name: "eye-open-negative-filled-symbolic";
                      }

                      Label label_views {
                        label: bind $format_number_compact(template.video as <$TFVideo>.views) as <string>;

                        styles [
                          "heading",
                        ]
                      }
                    }

                    Box box_likes {
                      styles [
                        "dim-label",
                      ]

                      visible: bind template.video as <$TFVideo>.has-likes;
                      spacing: 6;

                      Image {
                        icon-name: "thumbs-up-symbolic";
                      }

                      Label label_likes {
                        label: bind $format_number_compact(template.video as <$TFVideo>.likes) as <string>;

                        styles [
                          "heading",
                        ]
                      }
                    }

                    Box box_dislikes {
                      styles [
                        "dim-label",
                      ]

                      visible: bind template.video as <$TFVideo>.has-dislikes;
                      spacing: 6;

                      Image {
                        icon-name: "thumbs-down-symbolic";
                      }

                      Label label_dislikes {
                        label: bind $format_number_compact(template.video as <$TFVideo>.dislikes) as <string>;

                        styles [
                          "heading",
                        ]
                      }
                    }
                  }
                }
              }

              Label label_description {
                use-markup: true;
                // Kinora: a few lines until "Show more".
                label: bind $format_description($collapse_description(template.video as <$TFVideo>.description as <string>, template.description-expanded) as <string>) as <string>;
                selectable: true;
                wrap: true;
                wrap-mode: word_char;
                halign: start;
                justify: left;
                valign: start;
                xalign: 0.0;
              }

              Button {
                visible: bind $description_is_long(template.video as <$TFVideo>.description as <string>) as <bool>;
                label: bind $description_toggle_label(template.description-expanded) as <string>;
                halign: start;
                clicked => $toggle_description() swapped;

                styles [
                  "flat",
                ]
              }
            }

          }

            // Kinora: YouTube's "Up next", personalised by the account. Below
            // the details, or a column beside them in wide windows.
            // (The clamp gives the column its fixed width.)
            Adw.Clamp up_next_clamp {
              maximum-size: 10000;
              tightening-threshold: 10000;
              valign: start;

              Gtk.Box {
                orientation: vertical;
                valign: start;

                // The DJ's queue takes the place of Up next (see gui/dj.rs).
                Gtk.Box dj_slot {
                  orientation: vertical;
                  visible: false;
                }

                Gtk.Box up_next_box {
                  styles [
                    "k-upnext",
                  ]

                  orientation: vertical;
                  spacing: 6;
                  visible: false;
                  valign: start;

                  Gtk.Box {
                    spacing: 8;

                    Label {
                      label: _("Up next");
                      accessible-role: heading;
                      halign: start;
                      hexpand: true;

                      styles [
                        "k-row-title",
                      ]
                    }

                    Label {
                      label: _("Autoplay");

                      styles [
                        "dim-label",
                      ]
                    }

                    Switch autoplay_switch {
                      valign: center;
                      tooltip-text: _("Play the first Up next video when this one ends");
                    }
                  }

                  // A plain list, laid out in full inside the page's scrolling.
                  Gtk.ListBox up_next_list {
                    selection-mode: none;
                    activate-on-single-click: true;
                    row-activated => $up_next_row_activated() swapped;

                    styles [
                      "k-upnext-list",
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
    }
  }
}

// Keep up-to-date with window.blp and channel_page.blp.
menu menubar {
  section {
    item {
      label: _("Import");
      action: 'win.import';
    }

    item {
      label: _("Export");
      action: 'win.export';
    }
  }

  section {
    item {
      label: _("Preferences");
      action: 'win.settings';
    }

    item {
      label: _("Privacy Notice");
      action: 'win.privacy-notice';
    }

    item {
      label: _("Keyboard Shortcuts");
      action: 'win.show-help-overlay';
    }

    item {
      label: _("About Pipeline");
      action: 'win.about';
    }
  }
}
