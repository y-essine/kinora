using Gtk 4.0;
using Adw 1;

// Kinora: Home. A featured banner, then rows of videos (see docs/design.md).
template $TFHomeView: Adw.Bin {
  styles [
    "k-home",
  ]

  vexpand: true;
  hexpand: true;

  ScrolledWindow scroller {
    hscrollbar-policy: never;

    Box content {
      orientation: vertical;

      $TFFeaturedBanner banner {
        client: bind template.client;
        kicker: _("Featured");
        play-video => $forward_play() swapped;
      }

      // The DJ: endless music from the account's mix (see gui/dj.rs).
      Box {
        styles [
          "k-dj-strip",
        ]

        spacing: 16;
        visible: bind template.dj-available;

        Image {
          styles [
            "k-dj-strip-icon",
          ]

          icon-name: "audio-headphones-symbolic";
          pixel-size: 20;
          valign: center;
          accessible-role: presentation;
        }

        Box {
          orientation: vertical;
          valign: center;
          hexpand: true;
          spacing: 2;

          Label {
            styles [
              "k-card-title",
            ]

            label: _("Your mix, endlessly");
            xalign: 0;
            ellipsize: end;
          }

          Label {
            styles [
              "k-card-meta",
            ]

            label: _("The DJ plays music picked for you, one track fading into the next");
            xalign: 0;
            ellipsize: end;
          }
        }

        Button {
          styles [
            "pill",
            "suggested-action",
          ]

          label: _("Start DJ");
          valign: center;
          action-name: "win.dj-start-mix";
        }
      }

      // The built-in rows ("For you", "Watch again", ...).
      Box rows {
        styles [
          "k-rows",
        ]

        orientation: vertical;
      }

      // One row per topic of the account's Home ("Music", "Gaming", ...).
      Box topic_rows {
        styles [
          "k-rows",
        ]

        orientation: vertical;
        margin-bottom: 48;
      }
    }
  }
}
