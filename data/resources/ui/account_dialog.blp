using Gtk 4.0;
using Adw 1;

// Pipeline Home: connect a YouTube account by picking a signed-in browser profile.
template $TFAccountDialog: Adw.Dialog {
  title: _("Connect YouTube Account");
  content-width: 480;
  content-height: 600;

  child: Adw.ToastOverlay toast_overlay {
    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar {}

      content: Gtk.Stack stack {
        transition-type: crossfade;

        Gtk.StackPage {
          name: "scanning";

          child: Adw.StatusPage status_scanning {
            title: _("Looking for Signed-in Browsers");

            paintable: Adw.SpinnerPaintable {
              widget: status_scanning;
            };
          };
        }

        Gtk.StackPage {
          name: "list";

          child: Adw.PreferencesPage {
            Adw.PreferencesGroup {
              description: _("Pick a browser profile that is signed in to YouTube. Pipeline Home then shows that account's Home feed and Up next, and marks the videos you play as watched on it. Videos themselves still play without signing in.");
            }

            Adw.PreferencesGroup group_profiles {
              title: _("Signed-in Browser Profiles");
            }

            Adw.PreferencesGroup {
              title: _("Other Ways");

              Adw.ButtonRow {
                title: _("Use a cookies.txt File…");
                activated => $choose_file() swapped;
              }

              Adw.ButtonRow {
                title: _("Look Again");
                activated => $scan() swapped;
              }
            }

            Adw.PreferencesGroup {
              description: _("Tip: use a separate account. Using an account from an unofficial app is against YouTube's terms and can get the account flagged.");
            }
          };
        }

        Gtk.StackPage {
          name: "empty";

          child: Adw.StatusPage {
            icon-name: "web-browser-symbolic";
            title: _("No Signed-in Browser Found");
            description: _("Sign in to YouTube in Chromium, Chrome, Brave, Vivaldi, Edge, Firefox or LibreWolf, then look again.");

            child: Gtk.Box {
              orientation: vertical;
              spacing: 12;
              halign: center;

              Gtk.Button {
                label: _("Look Again");
                clicked => $scan() swapped;

                styles [
                  "pill",
                  "suggested-action",
                ]
              }

              Gtk.Button {
                label: _("Use a cookies.txt File…");
                clicked => $choose_file() swapped;

                styles [
                  "pill",
                ]
              }
            };
          };
        }

        Gtk.StackPage {
          name: "connecting";

          child: Adw.StatusPage status_connecting {
            title: _("Connecting");

            paintable: Adw.SpinnerPaintable {
              widget: status_connecting;
            };
          };
        }
      };
    };
  };
}
