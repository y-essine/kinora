<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@app-id@</id>
  <project_license>GPL-3.0-or-later</project_license>
  <metadata_license>FSFAP</metadata_license>
  <name>Kinora</name>
  <summary>Watch YouTube and PeerTube your way</summary>
  <launchable type="desktop-id">@app-id@.desktop</launchable>
  <content_rating type="oars-1.1"/>
  <developer id="io.github.y_essine">
    <name translate="no">y-essine</name>
  </developer>
  <translation type="gettext">@gettext-package@</translation>

  <releases>
    <release version="0.1.0-beta.6" date="2026-11-16" type="development">
      <description translate="no">
        <p>Kinora for Windows.</p> <ul> <li>A Windows build: unzip it anywhere and run bin\kinora.exe. It brings its own GTK, GStreamer, and Python with yt-dlp.</li> <li>Connect Account works on Windows with Firefox or a cookies.txt file (Chrome, Edge and Brave lock their cookies there).</li> <li>kinora --self-test checks an installation on its own: settings, plugins, playback, every page, and the account dialog.</li> <li>On Windows, a crash is recorded in crash.txt next to the log, and errors reach the log too.</li> <li>Fixed: a crash when a player was closed.</li> </ul>
      </description>
    </release>
    <release version="0.1.0-beta.5" date="2026-11-15" type="development">
      <description translate="no">
        <p>Previous and Next, and a DJ that mixes on every change.</p> <ul> <li>Previous and Next on the player, in fullscreen and on the mini-player.</li> <li>DJ: Next, Previous and picking a song in the queue all crossfade.</li> <li>The DJ plays audio with the album art by default (Show Video brings the videos back), and loads the next song ahead so it starts at once; resting the pointer on a queued song loads it too.</li> </ul>
      </description>
    </release>
    <release version="0.1.0-beta.4" date="2026-11-14" type="development">
      <description translate="no">
        <p>A new look, a player you can put down, and a DJ.</p> <ul> <li>A new design: a featured video and rows on Home, an ambient glow around the player.</li> <li>The player rises over the window and shrinks into a mini-player, so you can keep browsing while it plays.</li> <li>DJ: endless music from a song, your mix, a playlist or a mix, each track fading into the next.</li> <li>Mixes and your playlists on Home.</li> <li>The seek bar shows how much of the video is loaded.</li> <li>Extensions in the preferences, and a first-run choice of how you want to watch.</li> </ul>
      </description>
    </release>
    <release version="0.1.0-beta.3" date="2026-11-14" type="development">
      <description translate="no">
        <p>Faster and more complete Home and playback.</p> <ul> <li>Home loads straight from YouTube in about two seconds, with topic chips and more videos as you scroll.</li> <li>The next video is prepared in the background, so Up next and autoplay start in about a second.</li> <li>A thumbnail and spinner while a video starts, a collapsed description, and video pages that open at the top.</li> <li>Search can be limited to YouTube or PeerTube, and dates read like "4 years ago".</li> <li>Import your subscriptions from the connected YouTube account in one click.</li> </ul>
      </description>
    </release>
    <release version="0.1.0-beta.2" date="2026-11-14" type="development">
      <description translate="no">
        <p>First Kinora release, based on Pipeline 4.1.1.</p> <ul> <li>Optional YouTube account: Home feed, personal Up next, watch history on the account.</li> <li>Autoplay of the next video.</li> <li>Window fullscreen next to screen fullscreen.</li> <li>The player scrolls with the video page.</li> </ul>
      </description>
    </release>
  </releases>

  <description>
    <!-- Translators: Part of the description of the application in the metainfo. -->
    <p>
      Pipeline lets you watch and download videos from YouTube and PeerTube, all without needing to navigate through
      different websites. Its adaptive design allows you to enjoy content on any screen size.
    </p>
    <!-- Translators: Part of the description of the application in the metainfo. -->
    <p>
      Pipeline allows you to:
    </p>
    <!-- Translators: Part of the description of the application in the metainfo. -->
    <ul>
      <!-- Translators: Part of the description of the application in the metainfo. -->
      <li>Search for you favorite channels and subscribe to them.</li>
      <!-- Translators: Part of the description of the application in the metainfo. -->
      <li>Aggregate the videos of all subscriptions into a single feed.</li>
      <!-- Translators: Part of the description of the application in the metainfo. -->
      <li>Filter out unwanted items from the feed, like short videos or videos from a series.</li>
      <!-- Translators: Part of the description of the application in the metainfo. -->
      <li>Play those videos either in the built-in video player or with any other video player of your choice.</li>
      <!-- Translators: Part of the description of the application in the metainfo. -->
      <li>Download videos for offline viewing.</li>
      <!-- Translators: Part of the description of the application in the metainfo. -->
      <li>Manage videos you want to watch later.</li>
      <!-- Translators: Part of the description of the application in the metainfo. -->
      <li>Import your subscriptions from NewPipe or YouTube.</li>
      <!-- Translators: Part of the description of the application in the metainfo. -->
      <li>Supports YouTube, PeerTube with the possibility to extend to other platforms on request.</li>
    </ul>
  </description>

  <screenshots>
    <screenshot type="default">
      <caption>Playing a Video</caption>
      <image>https://gitlab.com/schmiddi-on-mobile/pipeline/-/raw/master/data/screenshots/video.png</image>
    </screenshot>
    <screenshot type="default">
      <caption>Viewing Videos of a Channel</caption>
      <image>https://gitlab.com/schmiddi-on-mobile/pipeline/-/raw/master/data/screenshots/channel.png</image>
    </screenshot>
    <screenshot type="default">
      <caption>Managing your Subscriptions</caption>
      <image>https://gitlab.com/schmiddi-on-mobile/pipeline/-/raw/master/data/screenshots/subscriptions.png</image>
    </screenshot>
    <screenshot type="default">
      <caption>Listing Videos to Watch Later</caption>
      <image>https://gitlab.com/schmiddi-on-mobile/pipeline/-/raw/master/data/screenshots/watch-later.png</image>
    </screenshot>
  </screenshots>

  <url type="homepage">https://github.com/y-essine/kinora</url>
  <url type="bugtracker">https://github.com/y-essine/kinora/issues</url>
  <url type="vcs-browser">https://github.com/y-essine/kinora</url>

  <provides>
    <binary>tubefeeder</binary>
  </provides>
  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
    <internet>always</internet>
  </recommends>
  <requires>
    <display_length compare="ge" side="shortest">300</display_length>
    <display_length compare="ge" side="longest">360</display_length>
  </requires>

  <branding>
    <color type="primary" scheme_preference="light">#62a0ea</color>
    <color type="primary" scheme_preference="dark">#1a5fb4</color>
  </branding>
</component>
