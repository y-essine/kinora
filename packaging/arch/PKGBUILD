# Maintainer: y-essine
# Based on the AUR pipeline-gtk PKGBUILD by Mark Wagie and contributors.
pkgname=kinora
pkgver=0.1.0beta.4
pkgrel=1
pkgdesc="Watch YouTube and PeerTube your way: fully anonymous, lightweight, or with your account"
arch=('x86_64' 'aarch64')
url="https://github.com/y-essine/kinora"
license=('GPL-3.0-or-later')
depends=(
  'clapper-enhancers'
  'gtk4'
  'libadwaita'
  'libclapper'
  'libclapper-gtk'
  'openssl'
  'python-secretstorage'
  'sqlite'
  'yt-dlp'
)
makedepends=(
  'blueprint-compiler'
  'cargo'
  'git'
  'meson'
)
checkdepends=(
  'appstream'
  'desktop-file-utils'
)
optdepends=(
  'gst-libav: more video formats'
  'gst-plugin-va: hardware video decoding'
)
# Kinora has its own app ID, so it installs next to upstream Pipeline.
conflicts=('pipeline-home')
replaces=('pipeline-home')
# Arch's default LTO turns rquickjs' bundled C (QuickJS) into GCC bytecode that
# Rust's linker can't read (undefined JS_* symbols).
options=('!lto')
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  local base
  # pacman versions can't contain "-": 0.1.0-beta.1 -> 0.1.0beta.1 (sorts before 0.1.0).
  base=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)
  base=${base//-/}
  # Commits on top of the upstream import (the root commit).
  printf "%s.r%s.g%s" "$base" "$(( $(git rev-list --count HEAD) - 1 ))" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target host-tuple
}

build() {
  export GETTEXT_SYSTEM=true
  export LIBSQLITE3_SYS_USE_PKG_CONFIG=1
  export OPENSSL_NO_VENDOR=1
  export RUSTUP_TOOLCHAIN=stable
  arch-meson "$pkgname" build
  meson compile -C build
}

check() {
  meson test -C build --no-rebuild --print-errorlogs
}

package() {
  meson install -C build --no-rebuild --destdir "$pkgdir"
  install -Dm755 "$pkgname/extras/kinora-account" "$pkgdir/usr/bin/kinora-account"
  install -Dm755 "$pkgname/extras/kinora-prepare" "$pkgdir/usr/bin/kinora-prepare"
}
