#: data/de.schmidhuberj.tubefeeder.desktop.in.in:5
#: data/de.schmidhuberj.tubefeeder.metainfo.xml.in.in:7
msgid "Follow video creators"
msgstr "Theo dõi các nhà sáng tạo nội dung"

#: data/de.schmidhuberj.tubefeeder.desktop.in.in:11
msgid "youtube;peertube;video;"
msgstr "youtube;peertube;video;"

#. Translators: Part of the description of the application in the metainfo.
#: data/de.schmidhuberj.tubefeeder.metainfo.xml.in.in:460
msgid ""
"Pipeline lets you watch and download videos from YouTube and PeerTube, all "
"without needing to navigate through different websites. Its adaptive design "
"allows you to enjoy content on any screen size."
msgstr ""
"Pipeline cho phép bạn xem và tải xuống video từ YouTube và PeerTube mà không "
"cần phải điều hướng qua các trang web khác nhau. Thiết kế thích ứng của nó "
"cho phép bạn thưởng thức nội dung trên mọi kích thước màn hình."

#. Translators: Part of the description of the application in the metainfo.
#: data/de.schmidhuberj.tubefeeder.metainfo.xml.in.in:465
msgid "Pipeline allows you to:"
msgstr "Pipeline cho phép bạn:"

#. Translators: Part of the description of the application in the metainfo.
#: data/de.schmidhuberj.tubefeeder.metainfo.xml.in.in:471
msgid "Search for you favorite channels and subscribe to them."
msgstr "Tìm kiếm những kênh bạn yêu thích và đăng ký chúng."

#. Translators: Part of the description of the application in the metainfo.
#: data/de.schmidhuberj.tubefeeder.metainfo.xml.in.in:473
msgid "Aggregate the videos of all subscriptions into a single feed."
msgstr "Tổng hợp các video của tất cả đăng ký vào một feed duy nhất."

#. Translators: Part of the description of the application in the metainfo.
#: data/de.schmidhuberj.tubefeeder.metainfo.xml.in.in:475
msgid ""
"Filter out unwanted items from the feed, like short videos or videos from a "
"series."
msgstr ""
"Lọc các mục không mong muốn khỏi feed, như video ngắn hoặc video từ loạt "
"video."

#. Translators: Part of the description of the application in the metainfo.
#: data/de.schmidhuberj.tubefeeder.metainfo.xml.in.in:477
msgid ""
"Play those videos either in the built-in video player or with any other "
"video player of your choice."
msgstr ""
"Phát những video đó trong trình phát video tích hợp hoặc với bất kỳ trình "
"phát video nào khác mà bạn chọn."

#. Translators: Part of the description of the application in the metainfo.
#: data/de.schmidhuberj.tubefeeder.metainfo.xml.in.in:479
msgid "Download videos for offline viewing."
msgstr "Tải xuống video để xem ngoại tuyến."

#. Translators: Part of the description of the application in the metainfo.
#: data/de.schmidhuberj.tubefeeder.metainfo.xml.in.in:481
msgid "Manage videos you want to watch later."
msgstr "Quản lý các video mà bạn muốn xem sau."

#. Translators: Part of the description of the application in the metainfo.
#: data/de.schmidhuberj.tubefeeder.metainfo.xml.in.in:483
msgid "Import your subscriptions from NewPipe or YouTube."
msgstr "Nhập dữ liệu từ NewPipe hoặc Youtube."

#. Translators: Part of the description of the application in the metainfo.
#: data/de.schmidhuberj.tubefeeder.metainfo.xml.in.in:485
msgid ""
"Supports YouTube, PeerTube with the possibility to extend to other platforms "
"on request."
msgstr ""
"Hỗ trợ YouTube, PeerTube với khả năng mở rộng sang các nền tảng khác theo "
"yêu cầu."

#: data/de.schmidhuberj.tubefeeder.metainfo.xml.in.in:491
msgid "Playing a Video"
msgstr "Phát một video"

#: data/de.schmidhuberj.tubefeeder.metainfo.xml.in.in:495
