msgstr "Перезагрузить при запуске"

#: data/resources/ui/preferences_dialog.blp:17
msgid "Keep Watch History"
msgstr "Хранить историю просмотров"

#: data/resources/ui/preferences_dialog.blp:32
msgid "Video Downloads"
msgstr "Загрузчик видео"

#: data/resources/ui/preferences_dialog.blp:40
msgid "Custom Download Format"
msgstr "Индивидуальный формат загрузок"

#: data/resources/ui/preferences_dialog.blp:46
