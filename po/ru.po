msgid "External Programs"
msgstr "Сторонние программы"

#: data/resources/ui/preferences_dialog.blp:56
msgid "Play with External Player by Default"
msgstr "Использовать сторонний видеоплеер по умолчанию"

#: data/resources/ui/preferences_dialog.blp:60
msgid "External Video Player"
msgstr "Сторонний видеоплеер"

#: data/resources/ui/preferences_dialog.blp:68
msgid "YouTube Preferences"
msgstr "Параметры YouTube"

#: data/resources/ui/preferences_dialog.blp:78
msgid "Enable YouTube"
msgstr "Включить YouTube"

#: data/resources/ui/preferences_dialog.blp:79
msgid "Allow Pipeline to fetch YouTube videos"
msgstr "Разрешите Pipeline загружать видео из YouTube"

#: data/resources/ui/preferences_dialog.blp:94
msgid "Prefer Fetching Information Directly from YouTube"
msgstr "Предпочитать загрузку информации напрямую из YouTube"

#: data/resources/ui/preferences_dialog.blp:95
msgid "On errors, try to fetch information using Piped. Recommended."
msgstr ""
"При ошибках, попробовать загрузить информацию через Piped. Рекомендуется."

#: data/resources/ui/preferences_dialog.blp:103
msgid "Prefer Fetching Information Using Piped"
msgstr "Предпочитать загружать информацию через Piped"

#: data/resources/ui/preferences_dialog.blp:104
msgid "On errors, try to fetch information from YouTube"
msgstr "При ошибках, попробовать загрузить информацию из YouTube"

#: data/resources/ui/preferences_dialog.blp:112
msgid "Always Fetch Information Directly from YouTube"
msgstr "Всегда загружать информацию напрямую из YouTube"

