msgid "Additional yt-dlp arguments."
msgstr "آرگومان‌های اضافی yt-dlp."

#: data/de.schmidhuberj.tubefeeder.gschema.xml:38
msgid "Let Pipeline fetch videos from YouTube"
msgstr "اجازه به خط لوله برای واکشی ویدیوها از یوتوب"

#: data/de.schmidhuberj.tubefeeder.gschema.xml:42
msgid "The piped api url"
msgstr "نشانی api پایپد"

