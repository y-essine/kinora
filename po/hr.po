#: data/resources/ui/preferences_dialog.blp:68
msgid "YouTube Preferences"
msgstr "YouTube postavke"

#: data/resources/ui/preferences_dialog.blp:78
msgid "Enable YouTube"
msgstr "Uključi YouTube"

#: data/resources/ui/preferences_dialog.blp:79
